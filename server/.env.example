DATABASE_URL="postgresql://postgres:postgres@localhost:5434/clyptus_recruitment?schema=public"
JWT_SECRET="replace-with-a-strong-secret"
GOOGLE_CLIENT_ID="757826816013-94bsvho5dfr0idssnh70dti18497o166.apps.googleusercontent.com"
RESEND_API_KEY="re_replace_with_your_resend_api_key"
EMAIL_FROM="Clyptus <verify@your-verified-domain.com>"
# Prototype toggle: set to false to auto-verify local candidate registrations and skip OTP flow.
EMAIL_VERIFICATION_REQUIRED="false"
# Optional dedicated HMAC key for verification codes; falls back to JWT_SECRET.
OTP_HASH_SECRET="replace-with-a-long-random-secret"
RESUME_STORAGE_DIR="./uploads/resumes"
PROFILE_PHOTO_STORAGE_DIR="./uploads/profile-photos"
PORT=3000

# SAP Assistant backend — server-side only. Never expose these in VITE_* variables.
SAP_ASSISTANT_BASE_URL="http://localhost:8000"
SAP_ASSISTANT_INTEGRATION_KEY="replace-with-the-matching-server-only-integration-key"

# Production notes:
# - Set SAP_ASSISTANT_BASE_URL to the deployed SAP Assistant service URL.
# - Keep SAP_ASSISTANT_INTEGRATION_KEY in the server environment only; never expose it to the browser.
# - Use HTTPS in production and configure the same CORS allowlist as the frontend origin.
